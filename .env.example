# Copy to .env and adjust. Never commit .env.

# SQLite file used by Prisma (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Password assigned to all seeded demo staff accounts (prisma/seed.ts)
SEED_PASSWORD="password123"

# External AI inference service (the Random Forest server).
# Leave unset to use the built-in rule-based engine in src/lib/triage-engine.ts.
# Contract: POST {INFERENCE_URL}  — see src/lib/inference.ts for the request/response shape.
# INFERENCE_URL="http://192.168.1.10:8000/predict"
# INFERENCE_TIMEOUT_MS=5000
# INFERENCE_API_KEY=""

# Where patient photos are stored on the server (default: ./uploads)
# UPLOAD_DIR="/var/medtriage/uploads"
