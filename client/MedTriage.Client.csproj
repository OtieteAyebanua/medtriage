<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The MedTriage app for staff computers. It contains no server or database: it finds the facility's
    MedTriage Server on the network and opens it in an app window. See README.md.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MedTriage</AssemblyName>
    <RootNamespace>MedTriage.Client</RootNamespace>
    <ApplicationIcon>..\packaging\assets\medtriage.ico</ApplicationIcon>
    <!-- No console window on Windows: staff only ever see the app window -->
    <OutputType Condition="'$(RuntimeIdentifier)' == 'win-x64'">WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="ConnectPage.html" LogicalName="ConnectPage.html" />
  </ItemGroup>

</Project>
